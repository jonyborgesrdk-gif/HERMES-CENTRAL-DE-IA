SECOES_LOCAIS = {'conexoes': 'PAINEL_CONEXOES', 'comando': 'PAINEL_COMANDO',
                 'rede_sessao': 'PAINEL_REDE_SESSAO'}
ERRO_CONEXOES = "conexões: sem leitura"
ERRO_COMANDO = "comando atual: sem leitura"
MAX_LOCAL_LIDO = 4 * 1024 * 1024
MAX_LOCAL_GRAVADO = 7 * 1024 * 1024 // 2


def serializar_local(local):
    """Envelope de até 3,5 MiB em ASCII; corta um prefixo sem alterar o cache.

    Busca binária preserva o maior prefixo que cabe e refaz todos os agregados.
    Seções futuras também precisam respeitar o orçamento global do arquivo.
    """
    def serializar(valor):
        return json.dumps(valor, ensure_ascii=True, separators=(',', ':'), allow_nan=False) + '\n'

    texto = serializar(local)
    if len(texto) <= MAX_LOCAL_GRAVADO:
        return texto
    from fontes.conexoes import agregar
    secao = local.get('conexoes', {})
    itens = secao.get('itens', [])

    def cortar(quantidade):
        conexoes = agregar(itens[:quantidade], secao.get('omitidas', 0) + len(itens) - quantidade)
        return serializar(dict(local, conexoes=conexoes))

    melhor = cortar(0)
    if len(melhor) > MAX_LOCAL_GRAVADO:
        raise ValueError('limite local')
    inicio, fim = 1, len(itens) - 1
    while inicio <= fim:
        meio = (inicio + fim) // 2
        candidato = cortar(meio)
        if len(candidato) <= MAX_LOCAL_GRAVADO:
            melhor, inicio = candidato, meio + 1
        else:
            fim = meio - 1
    return melhor


def gravar_local(secoes, ctx, saida):
    """Um único escritor (coletor): mescla seções ativas; nunca escreve na saída pública.

    Sem seção habilitada não lê nem altera o arquivo anterior. Flags desligadas
    são retiradas na próxima gravação de alguma seção ativa; não há limpeza retroativa.
    """
    from fontes import diretorio
    ativas = {nome for nome, flag in SECOES_LOCAIS.items() if os.environ.get(flag) == '1'}
    if not ativas.intersection(secoes):
        return
    def resolver(caminho):
        valor = str(Path(caminho).resolve())
        # O prefixo estendido não pode esconder a relação com a raiz pública.
        if valor.startswith('\\\\?\\UNC\\'):
            valor = '\\\\' + valor[8:]
        elif valor.startswith('\\\\?\\'):
            valor = valor[4:]
        return Path(valor)

    destino = resolver(diretorio(ctx) / 'local.json')
    for publica in (comum.PASTA_PUBLICA, Path(saida)):
        raiz = resolver(publica)
        if destino == raiz or raiz in destino.parents:
            raise ValueError('diretório local dentro da saída pública')
    try:
        with destino.open('rb') as stream:
            bruto = stream.read(MAX_LOCAL_LIDO + 1)
        anterior = json.loads(bruto.decode('utf-8')) if len(bruto) <= MAX_LOCAL_LIDO else {}
        if not isinstance(anterior, dict):
            anterior = {}
    except Exception:  # Arquivo auxiliar inválido nunca pode congelar o feed público.
        anterior = {}
    local = {nome: anterior[nome] for nome in ativas if nome in anterior}
    local.update({nome: valor for nome, valor in secoes.items() if nome in ativas})
    momento = comum.agora()
    local.update(gerado_em=comum.iso(momento), gerado_em_epoch=int(momento.timestamp()))
    texto = serializar_local(local)
    try:
        comum.gravar_atomico(destino, texto, tentativas=6, espera=0.05)
    except PermissionError:
        logging.getLogger('painel.coletor').warning('local.json: gravação adiada por arquivo ocupado')
        return False
    return True


def resumo(dados):
    sem = [v["nome"] for v in dados["agentes"] if v["leitura"] != "ok"]
    trabalhando = sum(1 for v in dados["agentes"] if v["estado"] == "trabalhando")
    texto = "%s  telas: %d lidas, %d trabalhando" % (
        dados["gerado_em"][11:19], len(dados["agentes"]) - len(sem), trabalhando)
    if dados.get("origem") == "vivo":
        por_fonte = {}
        for agente in dados["agentes"]:
            fonte = agente["fonte"]
            por_fonte[fonte] = por_fonte.get(fonte, 0) + 1
        texto = "%s  vivo: %d agentes (%s), %d trabalhando" % (
            dados["gerado_em"][11:19], len(dados["agentes"]),
            ", ".join("%s=%d" % item for item in sorted(por_fonte.items())) or "sem sessões",
            trabalhando)
    if sem:
        texto += ", %d sem leitura (%s)" % (len(sem), ", ".join(sem))
    p = dados["prs"]
    if not p["consultado"]:
        texto += " · PRs: não consultados"
    elif p["erro"]:
        texto += " · PRs: ERRO: %s" % p["erro"]
    elif p["lido_em_epoch"]:
        texto += " · PRs: %d abertos, lidos há %d s" % (p["total"], dados["gerado_em_epoch"] - p["lido_em_epoch"])
    else:
        texto += " · PRs: lendo"
    c = dados.get("contas") or {}
    if c.get("consultadas"):
        consultando = sum(1 for conta in c["lista"] if conta["consultando"])
        com_erro = [conta["titulo"] for conta in c["lista"] if conta["erro"]]
        texto += " · contas: %d" % len(c["lista"]) + (", %d consultando" % consultando if consultando else "")
        if com_erro:
            texto += ", ERRO em " + ", ".join(com_erro)
        if c.get("erro"):
            texto += " · " + c["erro"]
    if dados["quadro"]["erro"]:
        texto += " · " + dados["quadro"]["erro"]
    return texto


def foto_das_contas(contas, estado_cotas, mapa, args):
    """Dispara as consultas às CLIs que estão na hora e devolve o estado das contas (None se desligado).
    A consulta roda em segundo plano; só a passada única espera por ela. Falha aqui não derruba a passada."""
    if contas is None:
        return None
    try:
        contas.atualizar(esperar=args.uma_vez)
        foto = contas.foto()
    except Exception as erro:   # o resto do painel segue; a próxima passada tenta de novo
        print("%s  contas: ERRO: %s: %s" % (time.strftime("%H:%M:%S"), type(erro).__name__, erro),
              file=sys.stderr, flush=True)
        return {"workspace": {}, "accounts": [], "discovery_error": "exception"}
    cotas.juntar_leituras(estado_cotas, modulo_contas.leituras_para_cotas(foto, mapa, time.time()))
    return foto


def passada(mapa, estado_prs, estado_cotas, fio_da_sonda, ultimas, args, contas=None):
    estado_prs.atualizar_se_for_hora(args.intervalo_prs, esperar=args.uma_vez)
    foto_contas = foto_das_contas(contas, estado_cotas, mapa, args)
    sonda = fio_da_sonda.sonda
    terminais = getattr(args, "terminais", None) or Tmux(mapa)
    leituras = {}
    for v in mapa["agentes"]:
        nome = v["nome"]
        # Terminal com o painel da sonda aberto: a tela dele não é a de sempre. Vale a leitura anterior.
        if nome in sonda.foto()[3] and nome in ultimas:
            leituras[nome] = ultimas[nome]
        else:
            leituras[nome] = ler_agente(v, args.telas, terminais)
    ultimas.update(leituras)
    sonda.liberar_quem_voltou(leituras)
    cotas.juntar_leituras(estado_cotas, sonda.foto()[0])
    cotas_da_passada = cotas.atualizar(estado_cotas, mapa, leituras, time.time())
    dados = montar(mapa, leituras, estado_prs, cotas_da_passada, fio_da_sonda, args, foto_contas)
    gravar(dados, args.saida)
    if not args.uma_vez:
        fio_da_sonda.rodar_se_for_hora(args.intervalo_sonda)
    if args.estado:
        cotas.salvar(estado_cotas, args.estado)
    return dados


