def passada_viva(args, estado_prs=None, fontes=None, ctx=None, cache=None, overrides=None):
    """Fontes injetadas substituem integralmente as reais; cache pertence ao laço."""
    from fontes import epoch
    contexto = dict(ctx or {})
    contexto.setdefault("agora", time.time())
    agora = contexto["agora"]
    agora = agora.timestamp() if hasattr(agora, "timestamp") else float(agora)
    fontes = fontes_vivas(getattr(args, "sem_contas", False)) if fontes is None else fontes
    cache = {} if cache is None else cache
    leituras, situacao = {}, {}
    intervalos = {"servicos": 10, "processos": 5, "cota_claude": 300,
                  "whatsapp": 10, "gastos_hermes": 60, "presenca_processos": 5,
                  "presenca_linux": 20,
                  "cota_codex_local": 120, "cota_grok_bot": 60, "cota_cursor": 120,
                  "vigilante2": 30, "erros_agentes": 60,
                  "sessoes_grok": 10, "sessoes_hermes": 30, "chat_cursor": 120,
                  "rede_uso": 10, "maquina": 10, "custo_agentes": 300, "conexoes": 5,
                  "comando_atual": 2}
    extras = extras_ativos()
    locais = {'conexoes': ('conexoes', ERRO_CONEXOES), 'comando_atual': ('comando', ERRO_COMANDO)}
    if 'comando_atual' in extras:
        contexto['comando_cache'] = cache.setdefault('_comando_estado', {})
    atualizadas = set()
    for nome in ("eventos_hooks", "sessoes_codex", "maestri_wire", "cota_claude", "processos", "servicos") + extras:
        anterior = cache.get(nome)
        # A cadência não pode estender a retenção das fontes opt-in além dos 300 s.
        expirou = (nome in extras and anterior and anterior['situacao'].get('desatualizado')
                   and agora - anterior['ultima_leitura_ok'] > 300)
        if anterior and not expirou and 0 <= agora - anterior["hora"] < intervalos.get(nome, 0):
            leituras[nome], situacao[nome] = anterior["dados"], anterior["situacao"]
            continue
        ultima_ok = anterior.get("ultima_leitura_ok") if anterior else None
        atualizadas.add(nome)
        try:
            dado = fontes[nome](contexto) if nome in fontes else {}
            if not isinstance(dado, dict):
                raise ValueError("resposta inválida")
            if nome in locais:
                secao, constante = locais[nome]
                erro = constante if dado.get('erro') or not isinstance(dado.get(secao), dict) else None
            else:
                erro = texto_seguro(dado.get("erro"), 160)
        except Exception as exc:
            dado = {}
            erro = locais[nome][1] if nome in locais else "falha na fonte (%s)" % type(exc).__name__
        retido = False
        if erro and anterior and nome not in locais:
            # Tentativas ruins não rejuvenescem o último snapshot bom.
            retido = ultima_ok is not None and 0 <= agora - ultima_ok <= 300
            dado = anterior["dados"] if retido else {}
        elif not erro:
            ultima_ok = agora
        meta = {"ok": not bool(erro), "erro": erro, "hora": agora,
                "ultima_leitura_ok": ultima_ok, "desatualizado": retido}
        leituras[nome], situacao[nome] = dado, meta
        cache[nome] = {"hora": agora, "dados": dado, "situacao": meta,
                       "ultima_leitura_ok": ultima_ok}

    secoes = {}
    for nome, (chave, constante) in locais.items():
        if nome not in extras:
            continue
        # Separação antes da montagem pública: conteúdo local nunca chega a vivo/montar.
        local = leituras.pop(nome, {})
        saude = situacao[nome]
        if nome in atualizadas:
            secoes[chave] = local.get(chave) if saude['ok'] else {'estado': 'erro', 'erro': constante}
        situacao[nome] = {'ok': saude['ok'], 'erro': saude['erro']}
    if secoes:
        try:
            gravar_local(secoes, contexto, args.saida)
        except (OSError, ValueError):
            for nome, (chave, constante) in locais.items():
                if chave in secoes:
                    situacao[nome] = {'ok': False, 'erro': constante}

    transcripts, erros = {}, []
    anteriores = cache.get("transcripts_claude", {}).get("dados", {})
    for sessao in leituras["eventos_hooks"].get("sessoes", []):
        chave = sessao.get("session_id")
        try:
            dado = fontes["transcripts_claude"](dict(contexto, **{
                k: sessao[k] for k in ("cwd", "transcript_path") if k in sessao
            })) if "transcripts_claude" in fontes else {}
            if dado is None:
                transcripts[chave] = None
                continue
            if not isinstance(dado, dict):
                raise ValueError("resposta inválida")
            if dado.get("erro"):
                transcripts[chave] = anteriores.get(chave)
                erros.append("transcript sem leitura")
            else:
                transcripts[chave] = dado
        except Exception as erro:
            transcripts[chave] = anteriores.get(chave)
            erros.append("falha no transcript (%s)" % type(erro).__name__)
    leituras["transcripts_claude"] = transcripts
    situacao["transcripts_claude"] = {"ok": not bool(erros), "erro": "; ".join(sorted(set(erros))) or None, "hora": agora}
    cache["transcripts_claude"] = {"dados": transcripts, "hora": agora,
                                    "situacao": situacao["transcripts_claude"]}
    agentes = vivo.montar_agentes(leituras, agora, overrides or [])
    mapa = {"agentes": agentes, "repos": []}
    if estado_prs is None:
        estado_prs = EstadoDosPrs(mapa, consultar=not args.sem_gh)
    else:
        estado_prs.mapa = dict(estado_prs.mapa, agentes=agentes)
    estado_prs.atualizar_se_for_hora(args.intervalo_prs, esperar=args.uma_vez)
    grupo_do, grupos = {}, {}
    for agente in agentes:
        grupo = (agente.get("grupo_cota") or "vivo:claude") if agente["ferramenta"] == "claude" else (
            "vivo:%s:%s" % (agente["ferramenta"], agente.get("session_id") or agente["nome"]))
        grupo_do[agente["nome"]] = grupo
        cota = agente["cotas"]
        g = grupos.setdefault(grupo, {"membros": [], "origem": "vivo", "fonte": agente["fonte"],
            "sessao_5h_pct": cota.get("sessao_5h"), "semanal_pct": cota.get("semanal"),
            "lido_em_epoch": epoch(cota.get("hora")) or None, "evidencia": None,
            "renova_sessao": cota.get("reset_5h") if isinstance(cota.get("reset_5h"), str) else None,
            "renova_semanal": cota.get("reset_semanal") if isinstance(cota.get("reset_semanal"), str) else None,
            "renova_sessao_epoch": cota.get("reset_5h") if isinstance(cota.get("reset_5h"), (int, float)) else None,
            "renova_semanal_epoch": cota.get("reset_semanal") if isinstance(cota.get("reset_semanal"), (int, float)) else None})
        g["membros"].append(agente["nome"])
    dados = montar(mapa, {a["nome"]: a for a in agentes}, estado_prs,
                   (grupo_do, {}, grupos), None, args)
    for registro, agente in zip(dados["agentes"], agentes):
        registro.update({k: v for k, v in agente.items() if k not in ("missao", "prs", "grupo_cota")})
    dados.update(origem="vivo", servicos=leituras["servicos"].get("servicos", []),
                 processos=leituras["processos"], fontes=situacao,
                 contas=vivo.montar_contas(leituras, agora, agentes, disponiveis=fontes, saude=situacao))
    for nome in extras:
        if nome not in locais:
            dados[nome] = leituras[nome].get(nome, {"estado": "erro"})
    gravar(dados, args.saida)
    return dados


PORTA_PADRAO = 7420


class HandlerRefresh(http.server.BaseHTTPRequestHandler):
    """Atende exclusivamente POST /refresh em 127.0.0.1.

    Aceita apenas POST /refresh, sem corpo, sem ler nada da requisição, resposta 204;
    no máximo uma execução a cada 10 s; qualquer outro caminho ou método: 404/405.
    O handler acorda a passada (threading.Event) e roda o refresh-completo.
    """

    # O listener é single-thread: sem timeout, uma conexão pendurada trava o /refresh para todos.
    timeout = 5

    def log_message(self, format, *args):
        pass

    def do_POST(self):
        # Só o proxy do servidor.py chama este listener, e ele não envia Origin nem Sec-Fetch-Site.
        # Esses cabeçalhos presentes indicam um navegador falando direto (CSRF/DNS rebinding): 403.
        if self.headers.get("Origin") is not None or self.headers.get("Sec-Fetch-Site") is not None:
            self.send_response(403)
            self.send_header("Content-Length", "0")
            self.end_headers()
            return

        if self.path != "/refresh":
            self.send_response(404)
            self.end_headers()
            return

        agora = time.time()
        deve_executar = False
        with self.server.trava_trigger:
            if agora - self.server.ultimo_refresh >= 10.0:
                self.server.ultimo_refresh = agora
                deve_executar = True

        if deve_executar:
            # No modo --vivo o refresh-completo (quadro.json/tmux) é legado: só acorda o laço.
            if not getattr(self.server, "modo_vivo", False):
                try:
                    subprocess.run(
                        [sys.executable, "-I", str(comum.RAIZ / "refresh-completo")],
                        capture_output=True,
                        timeout=30,
                        **sem_janela_kwargs()
                    )
                except Exception as erro:
                    print("coletor: erro ao executar refresh-completo: %s" % erro, file=sys.stderr, flush=True)

            if hasattr(self.server, "estado_prs") and self.server.estado_prs:
                self.server.estado_prs.tentado_em = 0.0

            if hasattr(self.server, "evento_passada") and self.server.evento_passada:
                self.server.evento_passada.set()

        self.send_response(204)
        self.end_headers()

    def do_GET(self):
        if self.path == "/refresh":
            self.send_response(405)
        else:
            self.send_response(404)
        self.end_headers()

    def do_HEAD(self):
        self.do_GET()

    def do_PUT(self):
        self._metodo_invalido()

    def do_DELETE(self):
        self._metodo_invalido()

    def do_OPTIONS(self):
        self._metodo_invalido()

    def do_PATCH(self):
        self._metodo_invalido()

    def _metodo_invalido(self):
        if self.path == "/refresh":
            self.send_response(405)
        else:
            self.send_response(404)
        self.end_headers()


class ServidorRefresh(http.server.HTTPServer):
    allow_reuse_address = True


def subir_servidor_refresh(porta, evento_passada, estado_prs, modo_vivo=False):
    """Sobe o listener de POST /refresh em 127.0.0.1 e devolve o servidor (ou None se a porta falhar)."""
    try:
        servidor_http = ServidorRefresh(("127.0.0.1", porta), HandlerRefresh)
        servidor_http.evento_passada = evento_passada
        servidor_http.estado_prs = estado_prs
        servidor_http.ultimo_refresh = 0.0
        servidor_http.trava_trigger = threading.Lock()
        servidor_http.modo_vivo = modo_vivo
        threading.Thread(target=servidor_http.serve_forever, daemon=True).start()
        return servidor_http
    except Exception as erro:
        print("coletor: aviso: servidor HTTP em 127.0.0.1:%d falhou (%s); gatilho /refresh desativado." % (
            porta, erro), file=sys.stderr, flush=True)
        return None


def main():
    analisador = argparse.ArgumentParser(description="Coletor do Overview-Painel.", add_help=False)
    analisador.add_argument("-h", "--help", "--ajuda", action="store_true")
    analisador.add_argument("--uma-vez", action="store_true")
    origem = analisador.add_mutually_exclusive_group()
    origem.add_argument("--telas", metavar="PASTA")
    origem.add_argument("--vivo", action="store_true")
    analisador.add_argument("--sem-gh", action="store_true")
    analisador.add_argument("--sem-sonda", action="store_true")
    analisador.add_argument("--com-sonda", action="store_true")
    analisador.add_argument("--sem-contas", action="store_true")
    analisador.add_argument("--intervalo-sonda", type=int, default=300, metavar="SEGUNDOS")
    analisador.add_argument("--saida", metavar="PASTA", default=str(comum.PASTA_PUBLICA))
    analisador.add_argument("--estado", metavar="ARQUIVO")
    analisador.add_argument("--intervalo", type=int, metavar="SEGUNDOS")
    analisador.add_argument("--intervalo-prs", type=int, default=180, metavar="SEGUNDOS")
    analisador.add_argument("--porta", type=int, default=PORTA_PADRAO, metavar="PORTA")
    args = analisador.parse_args()
    if args.help:
        print(__doc__.strip())
        return 0
    args.intervalo = max(1 if args.vivo else 5, args.intervalo if args.intervalo is not None else (2 if args.vivo else 20))
    args.intervalo_prs = max(180, args.intervalo_prs)    # PRs e CI: a cada 3 minutos no máximo
    args.intervalo_sonda = max(120, args.intervalo_sonda)
    if args.telas and not Path(args.telas).is_dir():
        print("coletor: a pasta de telas não existe: %s" % args.telas, file=sys.stderr)
        return 2

    if args.vivo:
        # Sem mapa de exemplo, Tmux, Contas legadas ou FioDaSonda neste caminho.
        mapa = comum.carregar_mapa(comum.ARQ_AGENTES) if comum.ARQ_AGENTES.exists() else {"agentes": [], "repos": []}
        mapa.setdefault("repos", [])
        estado_prs = EstadoDosPrs(mapa, consultar=not args.sem_gh)
        cache = {}
        evento_passada = threading.Event()
        if not args.uma_vez:
            subir_servidor_refresh(args.porta, evento_passada, estado_prs, modo_vivo=True)
        while True:
            inicio = time.time()
            try:
                print(resumo(passada_viva(args, estado_prs, cache=cache, overrides=mapa["agentes"])), flush=True)
            except Exception as erro:
                print("coletor: erro na passada viva (%s)" % type(erro).__name__, file=sys.stderr, flush=True)
                if args.uma_vez:
                    return 1
            if args.uma_vez:
                return 0
            evento_passada.wait(timeout=max(0.1, args.intervalo - (time.time() - inicio)))
            evento_passada.clear()

    if not args.estado and not args.telas:      # telas de arquivo são teste: não mexem na memória real
        args.estado = str(comum.RAIZ / "estado.json")

    mapa = comum.carregar_mapa()
    estado_prs = EstadoDosPrs(mapa, consultar=not args.sem_gh)
    estado_cotas = cotas.carregar(args.estado) if args.estado else cotas.estado_vazio()
    # A sonda manda teclas a terminais de verdade: só com --com-sonda, e nunca com telas de arquivo
    # nem em passada única.
    fio_da_sonda = FioDaSonda(modulo_sonda.Sonda(mapa, registrar=registrar_sonda),
                              permitida=args.com_sonda and not (args.sem_sonda or args.telas or args.uma_vez))
    # A consulta às CLIs lê os processos dos terminais e roda `claude`, `codex` e `agy`: não com telas de
    # arquivo (teste), que não têm terminal nenhum.
    contas = None
    if not (args.sem_contas or args.telas):
        try:
            contas = modulo_contas.Contas(mapa)
        except Exception as erro:
            print("coletor: aviso: a consulta às CLIs não subiu (%s: %s); seguem só as status lines." % (
                type(erro).__name__, erro), file=sys.stderr, flush=True)

    evento_passada = threading.Event()
    if not args.uma_vez:
        subir_servidor_refresh(args.porta, evento_passada, estado_prs)

    ultimas = {}
    while True:
        inicio = time.time()
        try:
            print(resumo(passada(mapa, estado_prs, estado_cotas, fio_da_sonda, ultimas, args, contas)), flush=True)
        except Exception as erro:   # uma passada ruim não para o painel; a próxima tenta de novo
            print("%s  ERRO na passada: %s: %s" % (time.strftime("%H:%M:%S"), type(erro).__name__, erro),
                  file=sys.stderr, flush=True)
            if args.uma_vez:
                return 1
        if args.uma_vez:
            return 0
        espera = max(1.0, args.intervalo - (time.time() - inicio))
        evento_passada.wait(timeout=espera)
        evento_passada.clear()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
